# ==============================================================================
# Artifact Service - local development settings
# ==============================================================================
# Copy to .env (git-ignored) for a local run:
#     cp .env.example .env
# In a deployment these values come from the deployment environment, not a file.
# ==============================================================================

# --- Always required ----------------------------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32_min_32_chars
# Min 8 chars
POSTGRES_PASSWORD=changeme

# --- Local run ----------------------------------------------------------------
ENVIRONMENT=development
ENABLE_DOCS=true
# Keep auth ON. A loopback/RFC1918 caller is a trusted peer and needs only a tenant
# header; setting this false removes the middleware, so nothing resolves a tenant and
# every protected route 401s.
ENABLE_AUTH=true
ENABLE_VIRUS_SCANNING=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=artifact_registry
POSTGRES_USER=artifact_service

# --- Storage backend -----------------------------------------------------------
# Required for /upload. Run github.com/nonagenticai/storage_service next to this
# service and point these at it; metadata, manifest and health routes work without it.
# STORAGE_SERVICE_URL=http://localhost:8391
# STORAGE_BUCKET=artifacts

# --- Optional licence gate -----------------------------------------------------
# Setting ENABLE_AUTH=true requires a reachable licence introspection endpoint.
# LICENSE_INTROSPECT_URL=http://localhost:8544/license/introspect
